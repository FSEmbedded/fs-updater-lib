#pragma once

// Revision this library was built from. Reached through library_source_id()
// rather than by including this header from outside: a consumer compiled
// against one build can be linked against another.
#define FUS_LIB_SOURCE_ID "@FUS_SOURCE_ID@"

// U-Boot environment configuration
#define FUS_LIB_UBOOT_ENV_NAND "@UBOOT_ENV_NAND@"
#define FUS_LIB_UBOOT_ENV_MMC "@UBOOT_ENV_MMC@"

// Update version type
#cmakedefine01 UPDATE_VERSION_TYPE_STRING
#cmakedefine01 UPDATE_VERSION_TYPE_UINT64

// D-Bus RAUC communication support
/* Always 1: the D-Bus client is the only RAUC backend, and a build with the
 * option OFF stops at configure time. */
#cmakedefine01 BUILD_DBUS_SUPPORT

// Legacy image formats (raw application image, F&S container) and with them
// botan-2. Off: the units are not in the library and the dispatch seams
// refuse both formats as unsupported.
#cmakedefine01 FUS_LEGACY_IMAGE_SUPPORT

// v2.0 streaming reader: persistent-storage scratch path for the
// RAUC firmware bundle before `rauc install` consumes it. Override
// per-BSP with -DFSUP_RAUC_SCRATCH=... at cmake configure time.
#define FUS_LIB_RAUC_SCRATCH "@FSUP_RAUC_SCRATCH@"

// Application image store: persistent-storage directory holding
// app_a.squashfs/app_b.squashfs + verity sidecars + the .incoming staging
// file. Override per-BSP with -DFSUP_APP_IMG_STORE=... at cmake configure
// time so the RAUC app-bundle install hook script and this library agree.
#define FUS_LIB_APP_IMG_STORE "@FSUP_APP_IMG_STORE@"

// File holding the running application's version. Override per-BSP with
// -DFSUP_APP_VERSION_FILE=... where the application ships it elsewhere.
#define FUS_LIB_APP_VERSION_FILE "@FSUP_APP_VERSION_FILE@"
